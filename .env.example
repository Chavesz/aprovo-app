# Copie para .env (local) e cole os mesmos nomes em Netlify → Site configuration → Environment variables.
ANTHROPIC_API_KEY=            # chave da Anthropic (só no servidor)
SUPABASE_URL=                 # https://<projeto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=    # só no servidor (Netlify Functions). Nunca use no front.
VITE_SUPABASE_URL=            # mesmo valor de SUPABASE_URL (pode ir para o front)
VITE_SUPABASE_ANON_KEY=       # chave anon/publishable (pode ir para o front; o RLS protege)
