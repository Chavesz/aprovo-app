[{"id": "aprovo-pt-1", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 1, "disciplina": "Português", "assunto": "Crase", "enunciado": "", "comando": "Assinale a frase em que o acento grave está CORRETO.", "alternativas": [{"letra": "A", "texto": "Vou à pé para o trabalho."}, {"letra": "B", "texto": "Entreguei o relatório à diretora."}, {"letra": "C", "texto": "Ele começou à estudar cedo."}, {"letra": "D", "texto": "Refiro-me à esta proposta."}], "gabarito": "B", "comentario": "Há crase quando o termo regente pede 'a' e o termo seguinte aceita 'a' (diretora). Não há crase antes de verbo, de palavra masculina nem de pronome demonstrativo 'esta'.", "macete": "Troque por masculino: 'ao diretor' → tem crase."}, {"id": "aprovo-pt-2", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 2, "disciplina": "Português", "assunto": "Concordância verbal", "enunciado": "", "comando": "Assinale a frase de acordo com a norma-padrão.", "alternativas": [{"letra": "A", "texto": "Fazem dois anos que me formei."}, {"letra": "B", "texto": "Houveram muitas reclamações."}, {"letra": "C", "texto": "Existem candidatos aprovados."}, {"letra": "D", "texto": "Haviam vagas abertas."}], "gabarito": "C", "comentario": "'Existir' concorda com o sujeito (candidatos). 'Haver' no sentido de existir e 'fazer' indicando tempo são impessoais e ficam no singular.", "macete": "HAVER = existir → sempre singular."}, {"id": "aprovo-pt-3", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 3, "disciplina": "Português", "assunto": "Pontuação", "enunciado": "", "comando": "Em qual frase a vírgula está empregada INCORRETAMENTE?", "alternativas": [{"letra": "A", "texto": "Os candidatos, aprovaram o recurso."}, {"letra": "B", "texto": "Em Cuité, o concurso foi tranquilo."}, {"letra": "C", "texto": "Maria, feche a porta."}, {"letra": "D", "texto": "Estudei muito, mas não passei."}], "gabarito": "A", "comentario": "Não se separa sujeito do verbo por vírgula. As demais trazem adjunto deslocado, vocativo e oração adversativa.", "macete": "Sujeito + verbo: nunca vírgula no meio."}, {"id": "aprovo-pt-4", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 4, "disciplina": "Português", "assunto": "Regência verbal", "enunciado": "", "comando": "Assinale a regência correta segundo a norma-padrão.", "alternativas": [{"letra": "A", "texto": "Assisti o filme ontem."}, {"letra": "B", "texto": "Prefiro estudar do que trabalhar."}, {"letra": "C", "texto": "Obedeça o regulamento."}, {"letra": "D", "texto": "Aspiro ao cargo de agente."}], "gabarito": "D", "comentario": "'Aspirar' no sentido de desejar pede preposição 'a'. 'Assistir' (ver) pede 'a'; 'preferir' é 'preferir algo a outro'; 'obedecer' pede 'a'.", "macete": "Prefiro X A Y (nunca 'do que')."}, {"id": "aprovo-pt-5", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 5, "disciplina": "Português", "assunto": "Colocação pronominal", "enunciado": "", "comando": "Assinale a frase em que a colocação do pronome está correta.", "alternativas": [{"letra": "A", "texto": "Não diga-me isso."}, {"letra": "B", "texto": "Me empresta o livro?"}, {"letra": "C", "texto": "Nunca se esqueça do edital."}, {"letra": "D", "texto": "Tinha falado-lhe antes."}], "gabarito": "C", "comentario": "Palavras negativas (nunca, não) atraem o pronome para antes do verbo (próclise). Não se inicia frase com pronome oblíquo na norma-padrão e não há ênclise a particípio.", "macete": "Palavra negativa puxa o pronome."}, {"id": "aprovo-pt-6", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 6, "disciplina": "Português", "assunto": "Classes de palavras", "enunciado": "", "comando": "Em 'Ele chegou BASTANTE cansado', a palavra destacada é:", "alternativas": [{"letra": "A", "texto": "adjetivo"}, {"letra": "B", "texto": "advérbio"}, {"letra": "C", "texto": "pronome"}, {"letra": "D", "texto": "substantivo"}], "gabarito": "B", "comentario": "'Bastante' modifica o adjetivo 'cansado', funcionando como advérbio de intensidade (invariável). Seria adjetivo/pronome em 'bastantes candidatos'.", "macete": "Modifica adjetivo = advérbio = não varia."}, {"id": "aprovo-pt-7", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 7, "disciplina": "Português", "assunto": "Ortografia", "enunciado": "", "comando": "Assinale a palavra grafada corretamente.", "alternativas": [{"letra": "A", "texto": "excessão"}, {"letra": "B", "texto": "previlégio"}, {"letra": "C", "texto": "paralisação"}, {"letra": "D", "texto": "beneficiente"}], "gabarito": "C", "comentario": "Corretas: exceção, privilégio, paralisação, beneficente.", "macete": "Beneficente: sem 'i' extra."}, {"id": "aprovo-pt-8", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 8, "disciplina": "Português", "assunto": "Interpretação de texto", "enunciado": "", "comando": "'Embora o edital tenha saído tarde, os candidatos se prepararam.' A oração iniciada por 'embora' expressa:", "alternativas": [{"letra": "A", "texto": "causa"}, {"letra": "B", "texto": "concessão"}, {"letra": "C", "texto": "condição"}, {"letra": "D", "texto": "consequência"}], "gabarito": "B", "comentario": "'Embora' é conjunção concessiva: apresenta um obstáculo que não impede o fato principal.", "macete": "Embora = apesar de."}, {"id": "aprovo-rlm-1", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 1, "disciplina": "Raciocínio Lógico", "assunto": "Lógica proposicional", "enunciado": "", "comando": "A negação de 'Todos os candidatos estudaram' é:", "alternativas": [{"letra": "A", "texto": "Nenhum candidato estudou."}, {"letra": "B", "texto": "Algum candidato não estudou."}, {"letra": "C", "texto": "Todos os candidatos não estudaram."}, {"letra": "D", "texto": "Algum candidato estudou."}], "gabarito": "B", "comentario": "A negação de 'todo A é B' é 'algum A não é B'.", "macete": "Nega o TODO com ALGUM... NÃO."}, {"id": "aprovo-rlm-2", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 2, "disciplina": "Raciocínio Lógico", "assunto": "Lógica proposicional", "enunciado": "", "comando": "A negação de 'Estudo e passo' é:", "alternativas": [{"letra": "A", "texto": "Não estudo e não passo."}, {"letra": "B", "texto": "Não estudo ou não passo."}, {"letra": "C", "texto": "Estudo ou passo."}, {"letra": "D", "texto": "Se estudo, não passo."}], "gabarito": "B", "comentario": "Lei de De Morgan: ~(p ∧ q) ≡ ~p ∨ ~q.", "macete": "Nega o E: troca por OU e nega tudo."}, {"id": "aprovo-rlm-3", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 3, "disciplina": "Raciocínio Lógico", "assunto": "Condicional", "enunciado": "", "comando": "'Se chove, então a rua molha.' Uma proposição equivalente é:", "alternativas": [{"letra": "A", "texto": "Se a rua molha, então chove."}, {"letra": "B", "texto": "Se não chove, a rua não molha."}, {"letra": "C", "texto": "Se a rua não molha, então não chove."}, {"letra": "D", "texto": "Chove e a rua não molha."}], "gabarito": "C", "comentario": "A contrapositiva (~q → ~p) é equivalente à condicional p → q.", "macete": "Volta negando: inverte e nega os dois."}, {"id": "aprovo-rlm-4", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 4, "disciplina": "Raciocínio Lógico", "assunto": "Porcentagem", "enunciado": "", "comando": "Um produto de R$ 200 teve aumento de 10% e depois desconto de 10%. O preço final é:", "alternativas": [{"letra": "A", "texto": "R$ 200"}, {"letra": "B", "texto": "R$ 198"}, {"letra": "C", "texto": "R$ 202"}, {"letra": "D", "texto": "R$ 180"}], "gabarito": "B", "comentario": "200 × 1,10 = 220; 220 × 0,90 = 198.", "macete": "Aumento e desconto iguais sempre dão perda."}, {"id": "aprovo-rlm-5", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 5, "disciplina": "Raciocínio Lógico", "assunto": "Regra de três", "enunciado": "", "comando": "Se 4 agentes visitam 120 casas por dia, quantas casas 6 agentes visitam no mesmo ritmo?", "alternativas": [{"letra": "A", "texto": "150"}, {"letra": "B", "texto": "160"}, {"letra": "C", "texto": "180"}, {"letra": "D", "texto": "200"}], "gabarito": "C", "comentario": "Diretamente proporcional: 120/4 = 30 casas por agente; 30 × 6 = 180.", "macete": "Ache quanto vale 1 e multiplique."}, {"id": "aprovo-rlm-6", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 6, "disciplina": "Raciocínio Lógico", "assunto": "Sequências", "enunciado": "", "comando": "Qual o próximo número da sequência 2, 6, 18, 54, ...?", "alternativas": [{"letra": "A", "texto": "108"}, {"letra": "B", "texto": "162"}, {"letra": "C", "texto": "148"}, {"letra": "D", "texto": "216"}], "gabarito": "B", "comentario": "Progressão geométrica de razão 3: 54 × 3 = 162.", "macete": "Divida um termo pelo anterior para achar a razão."}, {"id": "aprovo-rlm-7", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 7, "disciplina": "Raciocínio Lógico", "assunto": "Probabilidade", "enunciado": "", "comando": "Ao lançar um dado comum, a probabilidade de sair número par é:", "alternativas": [{"letra": "A", "texto": "1/6"}, {"letra": "B", "texto": "1/3"}, {"letra": "C", "texto": "1/2"}, {"letra": "D", "texto": "2/3"}], "gabarito": "C", "comentario": "Pares: 2, 4, 6 → 3 casos em 6 → 1/2.", "macete": "Favoráveis ÷ possíveis."}, {"id": "aprovo-rlm-8", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 8, "disciplina": "Raciocínio Lógico", "assunto": "Análise combinatória", "enunciado": "", "comando": "De quantas formas 3 pessoas podem formar uma fila?", "alternativas": [{"letra": "A", "texto": "3"}, {"letra": "B", "texto": "6"}, {"letra": "C", "texto": "9"}, {"letra": "D", "texto": "12"}], "gabarito": "B", "comentario": "Permutação de 3: 3! = 3 × 2 × 1 = 6.", "macete": "Fila = ordem importa = fatorial."}, {"id": "aprovo-inf-1", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 1, "disciplina": "Informática", "assunto": "Segurança da informação", "enunciado": "", "comando": "Mensagem falsa que imita um banco para roubar senhas é chamada de:", "alternativas": [{"letra": "A", "texto": "spam"}, {"letra": "B", "texto": "phishing"}, {"letra": "C", "texto": "firewall"}, {"letra": "D", "texto": "backup"}], "gabarito": "B", "comentario": "Phishing é a fraude que se passa por instituição confiável para capturar dados.", "macete": "Phishing = 'pescar' a senha."}, {"id": "aprovo-inf-2", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 2, "disciplina": "Informática", "assunto": "Segurança da informação", "enunciado": "", "comando": "O malware que sequestra arquivos e pede resgate é o:", "alternativas": [{"letra": "A", "texto": "worm"}, {"letra": "B", "texto": "spyware"}, {"letra": "C", "texto": "ransomware"}, {"letra": "D", "texto": "adware"}], "gabarito": "C", "comentario": "Ransomware criptografa os dados e exige pagamento (ransom = resgate).", "macete": "Ransom = resgate."}, {"id": "aprovo-inf-3", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 3, "disciplina": "Informática", "assunto": "Planilhas", "enunciado": "", "comando": "No Excel/Calc, a fórmula =MÉDIA(A1:A4) com valores 2, 4, 6 e 8 retorna:", "alternativas": [{"letra": "A", "texto": "4"}, {"letra": "B", "texto": "5"}, {"letra": "C", "texto": "6"}, {"letra": "D", "texto": "20"}], "gabarito": "B", "comentario": "(2+4+6+8)/4 = 20/4 = 5.", "macete": "Dois-pontos = intervalo."}, {"id": "aprovo-inf-4", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 4, "disciplina": "Informática", "assunto": "Atalhos", "enunciado": "", "comando": "No Windows, o atalho para copiar é:", "alternativas": [{"letra": "A", "texto": "Ctrl+X"}, {"letra": "B", "texto": "Ctrl+V"}, {"letra": "C", "texto": "Ctrl+C"}, {"letra": "D", "texto": "Ctrl+Z"}], "gabarito": "C", "comentario": "Ctrl+C copia, Ctrl+X recorta, Ctrl+V cola, Ctrl+Z desfaz.", "macete": "C de Copiar."}, {"id": "aprovo-inf-5", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 5, "disciplina": "Informática", "assunto": "Internet", "enunciado": "", "comando": "O protocolo que indica conexão segura (criptografada) em sites é:", "alternativas": [{"letra": "A", "texto": "HTTP"}, {"letra": "B", "texto": "HTTPS"}, {"letra": "C", "texto": "FTP"}, {"letra": "D", "texto": "SMTP"}], "gabarito": "B", "comentario": "HTTPS usa TLS para criptografar a comunicação. SMTP envia e-mail; FTP transfere arquivos.", "macete": "S de Seguro."}, {"id": "aprovo-inf-6", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 6, "disciplina": "Informática", "assunto": "E-mail", "enunciado": "", "comando": "Ao enviar e-mail, o campo que oculta os destinatários dos demais é:", "alternativas": [{"letra": "A", "texto": "Para"}, {"letra": "B", "texto": "Cc"}, {"letra": "C", "texto": "Cco"}, {"letra": "D", "texto": "Assunto"}], "gabarito": "C", "comentario": "Cco (com cópia oculta) esconde quem recebeu a cópia.", "macete": "O 'o' é de oculto."}, {"id": "aprovo-inf-7", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 7, "disciplina": "Informática", "assunto": "Hardware", "enunciado": "", "comando": "A memória volátil, apagada ao desligar o computador, é a:", "alternativas": [{"letra": "A", "texto": "ROM"}, {"letra": "B", "texto": "RAM"}, {"letra": "C", "texto": "HD"}, {"letra": "D", "texto": "SSD"}], "gabarito": "B", "comentario": "RAM é volátil; ROM, HD e SSD guardam dados sem energia.", "macete": "RAM = rápida e esquecida."}, {"id": "aprovo-inf-8", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 8, "disciplina": "Informática", "assunto": "Editores de texto", "enunciado": "", "comando": "No Word em português, o atalho Ctrl+N aplica:", "alternativas": [{"letra": "A", "texto": "itálico"}, {"letra": "B", "texto": "sublinhado"}, {"letra": "C", "texto": "negrito"}, {"letra": "D", "texto": "novo documento"}], "gabarito": "C", "comentario": "No Word em português, Ctrl+N = negrito, Ctrl+I = itálico, Ctrl+S = sublinhado.", "macete": "N de Negrito."}, {"id": "aprovo-dc-1", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 1, "disciplina": "Direito Constitucional", "assunto": "Fundamentos da República", "enunciado": "", "comando": "Segundo o art. 1º da CF/88, é fundamento da República:", "alternativas": [{"letra": "A", "texto": "a dignidade da pessoa humana"}, {"letra": "B", "texto": "a erradicação da pobreza"}, {"letra": "C", "texto": "a independência nacional"}, {"letra": "D", "texto": "a prevalência dos direitos humanos"}], "gabarito": "A", "comentario": "Art. 1º: soberania, cidadania, dignidade da pessoa humana, valores sociais do trabalho e da livre iniciativa e pluralismo político. As outras são objetivos (art. 3º) ou princípios das relações internacionais (art. 4º).", "macete": "SO-CI-DI-VA-PLU."}, {"id": "aprovo-dc-2", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 2, "disciplina": "Direito Constitucional", "assunto": "Remédios constitucionais", "enunciado": "", "comando": "O remédio constitucional que protege a liberdade de locomoção é o:", "alternativas": [{"letra": "A", "texto": "mandado de segurança"}, {"letra": "B", "texto": "habeas data"}, {"letra": "C", "texto": "habeas corpus"}, {"letra": "D", "texto": "mandado de injunção"}], "gabarito": "C", "comentario": "Art. 5º, LXVIII: habeas corpus contra violência ou coação na liberdade de ir e vir.", "macete": "Corpus = corpo = ir e vir."}, {"id": "aprovo-dc-3", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 3, "disciplina": "Direito Constitucional", "assunto": "Remédios constitucionais", "enunciado": "", "comando": "Para obter informações pessoais constantes em banco de dados público, cabe:", "alternativas": [{"letra": "A", "texto": "habeas data"}, {"letra": "B", "texto": "ação popular"}, {"letra": "C", "texto": "habeas corpus"}, {"letra": "D", "texto": "mandado de segurança"}], "gabarito": "A", "comentario": "Art. 5º, LXXII: habeas data assegura conhecimento e retificação de informações da própria pessoa.", "macete": "Data = dados."}, {"id": "aprovo-dc-4", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 4, "disciplina": "Direito Constitucional", "assunto": "Saúde na Constituição", "enunciado": "", "comando": "Segundo a CF/88, a saúde é:", "alternativas": [{"letra": "A", "texto": "dever exclusivo dos municípios"}, {"letra": "B", "texto": "direito de todos e dever do Estado"}, {"letra": "C", "texto": "serviço privado regulado"}, {"letra": "D", "texto": "direito só dos contribuintes"}], "gabarito": "B", "comentario": "Art. 196: a saúde é direito de todos e dever do Estado, com acesso universal e igualitário.", "macete": "Art. 196 = SUS universal."}, {"id": "aprovo-dc-5", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 5, "disciplina": "Direito Constitucional", "assunto": "Administração Pública", "enunciado": "", "comando": "Os princípios expressos do art. 37 da CF/88 são:", "alternativas": [{"letra": "A", "texto": "legalidade, impessoalidade, moralidade, publicidade e eficiência"}, {"letra": "B", "texto": "legalidade, razoabilidade, moralidade e economicidade"}, {"letra": "C", "texto": "supremacia, indisponibilidade e publicidade"}, {"letra": "D", "texto": "isonomia, finalidade e eficiência"}], "gabarito": "A", "comentario": "Art. 37, caput: legalidade, impessoalidade, moralidade, publicidade e eficiência.", "macete": "LIMPE."}, {"id": "aprovo-dc-6", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 6, "disciplina": "Direito Constitucional", "assunto": "Administração Pública", "enunciado": "", "comando": "Pela CF/88, a investidura em cargo efetivo depende, em regra, de:", "alternativas": [{"letra": "A", "texto": "indicação política"}, {"letra": "B", "texto": "concurso público de provas ou de provas e títulos"}, {"letra": "C", "texto": "entrevista"}, {"letra": "D", "texto": "processo seletivo simplificado"}], "gabarito": "B", "comentario": "Art. 37, II: concurso público, ressalvados os cargos em comissão de livre nomeação.", "macete": "Efetivo = concurso."}, {"id": "aprovo-dc-7", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 7, "disciplina": "Direito Constitucional", "assunto": "Administração Pública", "enunciado": "", "comando": "O prazo de validade do concurso público é de:", "alternativas": [{"letra": "A", "texto": "até 1 ano, improrrogável"}, {"letra": "B", "texto": "até 2 anos, prorrogável uma vez por igual período"}, {"letra": "C", "texto": "até 4 anos"}, {"letra": "D", "texto": "5 anos"}], "gabarito": "B", "comentario": "Art. 37, III: até 2 anos, prorrogável uma vez por igual período.", "macete": "2 + 2 no máximo."}, {"id": "aprovo-dc-8", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 8, "disciplina": "Direito Constitucional", "assunto": "Direitos sociais", "enunciado": "", "comando": "Segundo o art. 6º da CF/88, NÃO é direito social expresso:", "alternativas": [{"letra": "A", "texto": "educação"}, {"letra": "B", "texto": "moradia"}, {"letra": "C", "texto": "transporte"}, {"letra": "D", "texto": "propriedade intelectual"}], "gabarito": "D", "comentario": "Art. 6º: educação, saúde, alimentação, trabalho, moradia, transporte, lazer, segurança, previdência, proteção à maternidade e à infância e assistência aos desamparados.", "macete": "Propriedade fica no art. 5º."}, {"id": "aprovo-da-1", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 1, "disciplina": "Direito Administrativo", "assunto": "Atos administrativos", "enunciado": "", "comando": "São atributos do ato administrativo:", "alternativas": [{"letra": "A", "texto": "presunção de legitimidade, imperatividade e autoexecutoriedade"}, {"letra": "B", "texto": "publicidade, moralidade e eficiência"}, {"letra": "C", "texto": "competência, finalidade e forma"}, {"letra": "D", "texto": "revogação e anulação"}], "gabarito": "A", "comentario": "Atributos: presunção de legitimidade (e veracidade), imperatividade, autoexecutoriedade e tipicidade. Competência, finalidade, forma, motivo e objeto são elementos.", "macete": "PATI = atributos; COFIFOMOB = elementos."}, {"id": "aprovo-da-2", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 2, "disciplina": "Direito Administrativo", "assunto": "Atos administrativos", "enunciado": "", "comando": "A retirada de um ato ilegal pela própria Administração chama-se:", "alternativas": [{"letra": "A", "texto": "revogação"}, {"letra": "B", "texto": "anulação"}, {"letra": "C", "texto": "cassação"}, {"letra": "D", "texto": "convalidação"}], "gabarito": "B", "comentario": "Ato ilegal é anulado (efeitos retroativos). Revogação retira ato legal por conveniência e oportunidade (Súmula 473 do STF).", "macete": "Ilegal → anula; inconveniente → revoga."}, {"id": "aprovo-da-3", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 3, "disciplina": "Direito Administrativo", "assunto": "Poderes administrativos", "enunciado": "", "comando": "A vigilância sanitária que interdita estabelecimento irregular exerce o poder:", "alternativas": [{"letra": "A", "texto": "hierárquico"}, {"letra": "B", "texto": "disciplinar"}, {"letra": "C", "texto": "de polícia"}, {"letra": "D", "texto": "regulamentar"}], "gabarito": "C", "comentario": "Poder de polícia limita a liberdade e a propriedade em favor do interesse público (art. 78 do CTN).", "macete": "Polícia = condiciona o particular."}, {"id": "aprovo-da-4", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 4, "disciplina": "Direito Administrativo", "assunto": "Poderes administrativos", "enunciado": "", "comando": "Punir um servidor por falta funcional é exercício do poder:", "alternativas": [{"letra": "A", "texto": "de polícia"}, {"letra": "B", "texto": "disciplinar"}, {"letra": "C", "texto": "regulamentar"}, {"letra": "D", "texto": "normativo"}], "gabarito": "B", "comentario": "O poder disciplinar apura infrações e aplica sanções a servidores e a quem tem vínculo especial com a Administração.", "macete": "Disciplinar = dentro de casa."}, {"id": "aprovo-da-5", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 5, "disciplina": "Direito Administrativo", "assunto": "Organização administrativa", "enunciado": "", "comando": "Autarquias, fundações públicas, empresas públicas e sociedades de economia mista compõem a Administração:", "alternativas": [{"letra": "A", "texto": "direta"}, {"letra": "B", "texto": "indireta"}, {"letra": "C", "texto": "concentrada"}, {"letra": "D", "texto": "privada"}], "gabarito": "B", "comentario": "Decreto-Lei 200/67: essas entidades formam a Administração indireta.", "macete": "Indireta = entidades com personalidade própria."}, {"id": "aprovo-da-6", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 6, "disciplina": "Direito Administrativo", "assunto": "Improbidade administrativa", "enunciado": "", "comando": "A Lei de Improbidade Administrativa é a:", "alternativas": [{"letra": "A", "texto": "Lei 8.080/1990"}, {"letra": "B", "texto": "Lei 8.429/1992"}, {"letra": "C", "texto": "Lei 8.666/1993"}, {"letra": "D", "texto": "Lei 14.133/2021"}], "gabarito": "B", "comentario": "Lei 8.429/1992, alterada pela Lei 14.230/2021, que passou a exigir dolo. A Lei 14.133/2021 é a nova Lei de Licitações.", "macete": "8.429 = improbidade."}, {"id": "aprovo-da-7", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 7, "disciplina": "Direito Administrativo", "assunto": "Licitações", "enunciado": "", "comando": "A atual Lei de Licitações e Contratos Administrativos é a:", "alternativas": [{"letra": "A", "texto": "Lei 8.666/1993"}, {"letra": "B", "texto": "Lei 10.520/2002"}, {"letra": "C", "texto": "Lei 14.133/2021"}, {"letra": "D", "texto": "Lei 12.462/2011"}], "gabarito": "C", "comentario": "A Lei 14.133/2021 substituiu as Leis 8.666/93, 10.520/02 e o RDC.", "macete": "14.133 = nova lei."}, {"id": "aprovo-da-8", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 8, "disciplina": "Direito Administrativo", "assunto": "Agentes públicos", "enunciado": "", "comando": "O servidor efetivo adquire estabilidade após:", "alternativas": [{"letra": "A", "texto": "2 anos de efetivo exercício"}, {"letra": "B", "texto": "3 anos de efetivo exercício"}, {"letra": "C", "texto": "1 ano"}, {"letra": "D", "texto": "5 anos"}], "gabarito": "B", "comentario": "Art. 41 da CF/88: estabilidade após 3 anos de efetivo exercício e avaliação especial de desempenho.", "macete": "Estágio = 3 anos."}, {"id": "aprovo-atu-1", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 1, "disciplina": "Atualidades", "assunto": "Meio ambiente", "enunciado": "", "comando": "A COP30, conferência do clima da ONU, foi sediada em 2025 na cidade de:", "alternativas": [{"letra": "A", "texto": "Manaus"}, {"letra": "B", "texto": "Belém"}, {"letra": "C", "texto": "Rio de Janeiro"}, {"letra": "D", "texto": "Brasília"}], "gabarito": "B", "comentario": "A COP30 ocorreu em Belém (PA), em novembro de 2025.", "macete": "Belém = porta da Amazônia."}, {"id": "aprovo-atu-2", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 2, "disciplina": "Atualidades", "assunto": "Saúde pública", "enunciado": "", "comando": "A arbovirose transmitida pelo Aedes aegypti com vacina incorporada ao SUS em 2024 é a:", "alternativas": [{"letra": "A", "texto": "malária"}, {"letra": "B", "texto": "dengue"}, {"letra": "C", "texto": "febre amarela"}, {"letra": "D", "texto": "leishmaniose"}], "gabarito": "B", "comentario": "Em 2024 o SUS passou a oferecer a vacina contra a dengue (Qdenga) para grupos prioritários.", "macete": "Aedes: dengue, zika, chikungunya."}, {"id": "aprovo-atu-3", "banca": "Aprovô (autoral)", "orgao": "Matérias comuns", "prova": "Questões autorais do Aprovô", "ano": 2026, "numero": 3, "disciplin