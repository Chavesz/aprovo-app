ociedade", "enunciado": "", "comando": "O Censo Demográfico mais recente do IBGE, com resultados divulgados a partir de 2023, foi realizado em:", "alternativas": [{"letra": "A", "texto": "2020"}, {"letra": "B", "texto": "2021"}, {"letra": "C", "texto": "2022"}, {"letra": "D", "texto": "2010"}], "gabarito": "C", "comentario": "O Censo foi adiado pela pandemia e realizado em 2022, com população de cerca de 203 milhões.", "macete": "Censo 2022: 203 milhões."}]